# Local development only. Generate a private .env with:
# python3 infra/scripts/init_env.py
COMPOSE_PROJECT_NAME=tok-talk
FRONTEND_PORT=5174
AUTH_PORT=8080
RAG_PORT=8001
DB_HOST_PORT=13306

DB_NAME=tok_talk
DB_USER=toktalk
DB_PASSWORD=
DB_ROOT_PASSWORD=

JWT_SECRET=
JWT_ISSUER=simple-auth-server
CORS_ORIGINS=http://localhost:5174
VITE_AUTH_BASE_URL=http://localhost:8080
VITE_RAG_BASE_URL=http://localhost:8001
RAG_INDEX_PATH=/data/indexes/current
KOSHA_REFRESH_HOURS=24

# Add provider/model choices when implementing the RAG service.
# Keep all LLM credentials on the server. VITE_* is public.
LLM_API_KEY=

OPENAI_API_KEY=
KOSHA_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Server-side only. Never expose this key through a VITE_* variable.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_LANGUAGE=kor
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_SECONDS=60
ELEVENLABS_MAX_AUDIO_BYTES=10485760
